theorem kappa_m1_Q3_barrier_internal (u : Word)
    (h_q : (evalWord u).q ≤ 3)
    (h_cyl : (evalWord u).n % (3 ^ 24) = aS202 % (3 ^ 24)) :
    (1 : Int) ≤ defect (evalWord u) :=
